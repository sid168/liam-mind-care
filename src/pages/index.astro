---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import FAQItem from "../components/FAQItem.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { site } from "../data/site";

const pillars = [
  {
    title: "Emotional & Mental Health",
    href: "/services/individual-therapy/",
    items: [
      "Anxiety, stress, depression & panic attacks",
      "OCD & intrusive thoughts",
      "Trauma, abuse & stress-related concerns",
      "Fear, phobia & panic support",
      "Addiction recovery support",
      "Sleep problems & insomnia",
    ],
  },
  {
    title: "Relationship & Family Support",
    href: "/services/couples-family-counseling/",
    items: [
      "Relationship issues & marital conflict",
      "Couple counseling",
      "Family & parent counseling",
      "Narcissistic abuse recovery",
      "Women's mental health & postpartum support",
      "Adolescent & teen counseling",
    ],
  },
  {
    title: "Psychological Assessments",
    href: "/services/psychological-assessments/",
    items: [
      "Autism screening & assessment",
      "ADHD screening & assessment",
      "Learning disability assessment",
      "Psychometric & IQ testing",
      "Developmental delay concerns",
      "School readiness evaluation",
    ],
  },
  {
    title: "Lifestyle, Career & Growth",
    href: "/services/corporate-workplace-wellness/",
    items: [
      "Career guidance & counseling",
      "Workplace mental health & burnout support",
      "Financial stress counseling",
      "Self-esteem & confidence building",
      "Academic stress & exam anxiety",
      "Corporate Employee Assistance Programs (EAP)",
    ],
  },
];

const trustPoints = [
  "7+ years clinical, educational & corporate experience",
  "PhD Scholar, trained at Harvard Medical School",
  "In-person in Hyderabad + online worldwide",
  "Strictly confidential, judgment-free space",
];
---

<BaseLayout
  title="Liam Mind Care | Psychological Therapy & Counseling in Hyderabad"
  description="Confidential psychological therapy and counseling in Hyderabad and online worldwide. Evidence-based support for anxiety, depression, relationships, autism/ADHD screening, teens, and workplace stress with psychologist Iqra Ali."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-100 via-sky-50 to-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-24 md:px-8">
      <div>
        <p class="inline-block rounded-full bg-blue-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-blue-600">
          Center for Mental Well-Being
        </p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-navy-900 md:text-5xl">
          A Calm, Confidential Space to Feel Better
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-navy-700">
          {site.tagline}. Compassionate, evidence-based psychological therapy and counseling in Hyderabad and
          online worldwide — for anxiety, depression, relationships, autism & ADHD screening, teens, and life's
          toughest transitions.
        </p>
        <p class="mt-3 text-sm italic text-blue-600">You don't have to have it all figured out. You just have to start.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`https://wa.me/${site.whatsappRaw}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-navy-900 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
          >
            Book a Confidential Session
          </a>
          <a
            href="/services/"
            class="rounded-full border border-navy-800 px-7 py-3.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-blue-100"
          >
            Explore Services
          </a>
        </div>
        <ul class="mt-8 grid grid-cols-1 gap-2 text-sm text-navy-700 sm:grid-cols-2">
          {trustPoints.map((point) => (
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 shrink-0 text-blue-500" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {point}
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-[2.5rem] shadow-xl">
          <img src="/images/space/space-8.jpeg" alt="Warm, welcoming waiting area at Liam Mind Care" class="h-full w-full object-cover" />
        </div>
        <div class="absolute -bottom-6 left-1/2 w-[85%] -translate-x-1/2 rounded-2xl bg-white p-5 text-center shadow-lg">
          <p class="text-sm font-medium text-navy-800">
            "A safe, welcoming space where I felt truly heard and understood."
          </p>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-blue-600">— Client H.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold text-navy-900">How We Can Support You</h2>
      <p class="mx-auto mt-3 max-w-2xl text-navy-700">
        Whatever brought you here, there is a path forward. Explore the areas we support most often.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar) => (
        <a href={pillar.href} class="group flex flex-col rounded-3xl border border-blue-100 bg-white p-7 transition-shadow hover:shadow-lg">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-blue-100 text-blue-600">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-4.35-9.5-8.5C.75 9 2.5 5.5 6 5c2-.3 3.5.7 6 3 2.5-2.3 4-3.3 6-3 3.5.5 5.25 4 3.5 7.5C19 16.65 12 21 12 21Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="mt-5 font-serif text-xl font-semibold text-navy-900">{pillar.title}</h3>
          <ul class="mt-4 flex-1 space-y-2 text-sm text-navy-700">
            {pillar.items.map((item) => <li>• {item}</li>)}
          </ul>
          <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-600">
            Learn more
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:grid-cols-2 md:px-8">
      <div class="order-2 md:order-1">
        <div class="aspect-[4/3] w-full overflow-hidden rounded-3xl shadow-md">
          <img src="/images/space/space-2.jpeg" alt="Comfortable therapy room at Liam Mind Care" class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Meet Your Psychologist</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-navy-900">Iqra Ali</h2>
        <p class="mt-1 text-sm font-medium text-blue-600">PhD Scholar — Clinical Psychology</p>
        <p class="mt-4 leading-relaxed text-navy-700">
          With 7+ years of experience across clinical, educational, and corporate settings, Iqra brings an
          integrative, trauma-informed approach drawing from CBT, DBT, psychodynamic, and solution-focused
          therapy — including advanced training in General Psychiatric Management for Borderline Personality
          Disorder from Harvard Medical School.
        </p>
        <p class="mt-4 italic text-navy-700">
          "Seeking support is not a weakness — it is a courageous step toward healing, resilience, and
          transformation."
        </p>
        <a href="/about/" class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700">
          Read Iqra's full story
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 md:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold text-navy-900">Common Questions</h2>
    <div class="mt-8 space-y-3">
      <FAQItem question="How do I book a session?" open>
        Simply reach out via WhatsApp or the contact form. We'll confirm a time that works for you — sessions
        are by appointment only, available online worldwide or in-person across Hyderabad (Narsingi, Manikonda,
        Kokapet, and Tolichowki).
      </FAQItem>
      <FAQItem question="Is everything I share confidential?">
        Yes. All sessions are strictly confidential and handled with complete discretion, in line with
        professional ethical standards.
      </FAQItem>
      <FAQItem question="Do I need a diagnosis or referral to start?">
        No referral or prior diagnosis is needed. Many clients simply want a safe space to talk through stress,
        relationships, or life transitions — you don't need a "reason" to begin therapy.
      </FAQItem>
    </div>
    <div class="mt-8 text-center">
      <a href="/faq/" class="text-sm font-semibold text-blue-600 hover:text-blue-700">View all FAQs →</a>
    </div>
  </section>

  <WaveDivider toColor="#16265c" />
  <CTASection />
</BaseLayout>
