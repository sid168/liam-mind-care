---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import FAQItem from "../components/FAQItem.astro";
import WaveDivider from "../components/WaveDivider.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { site } from "../data/site";

const googleReviews = [
  { name: "Syeda Umm e Kulsum", time: "3 months ago", text: "Iqra has been a huge huge support system for me and my family. The most important thing is that she is a very good human being. She's a master of her field and", truncated: true },
  { name: "Humaira Fatma", time: "5 months ago", text: "I've been in touch with iqra ma'am for a long period of time, and I must say she understands me in way that nobody does.. She's my safe place.. I feel no judgement from her.. And she's just amazing I wish I'd met her earlier.." },
  { name: "Dr Yousuf Khan", time: "3 months ago", text: "Miss. Iqra Ali is an excellent author apart from a learned Psychologist. Her book MOTHERHOOD is really thought provoking and a great guide for parents to raise confident & happy kids." },
  { name: "Nasha Ly", time: "5 months ago", text: "I was struggling a lot mentally and unable to think straight. miss iqra has helped me heal a lot and changed my perception over life ..I'm so grateful for her", truncated: true },
  { name: "Shobha", time: "2 months ago", text: "Iqra Ma'am treats everyone has humane as possible. Her love towards patients and concern regarding their well being makes her a go to psychologist." },
  { name: "Aditya", time: "a month ago", text: "I accompanied my friend to Liam Mind Care, and I am seeing a lot of improvement in her mental health. What stood out for her is that Iqra Ma'am was available", truncated: true },
  { name: "Vandana Singh", time: "2 weeks ago", text: "Thankyou Liam mind care 🙏🏻" },
  { name: "Shivansh Purohit", time: "2 weeks ago", text: "Iqra is truly an excellent person who creates a safe, welcoming, and comfortable environment. She is compassionate, understanding, and genuinely attentive,", truncated: true },
];

const pillars = [
  {
    title: "Emotional & Mental Health",
    href: "/services/individual-therapy/",
    image: "/images/yoga-woman.jpg",
    imageAlt: "Woman practicing calm, mindful movement outdoors",
    items: [
      "Individual Therapy",
      "Anxiety, stress, depression & panic attacks",
      "OCD & intrusive thoughts",
      "Anger management",
      "Smoking, alcohol & substance de-addiction",
      "Rehab, post-rehab & relapse prevention",
    ],
  },
  {
    title: "Relationship & Family Support",
    href: "/services/couples-family-counseling/",
    image: "/images/family-playing.jpg",
    imageAlt: "Family playing together in a cozy living room",
    items: [
      "Couples Therapy",
      "Family Therapy",
      "Relationship issues & marital conflict",
      "Family & parent counseling",
      "Narcissistic abuse recovery",
      "Women's mental health & postpartum support",
    ],
  },
  {
    title: "Child Psychology & Assessments",
    href: "/services/psychological-assessments/",
    image: "/images/student-engagement/shri-ram-academy.jpeg",
    imageAlt: "Iqra Ali leading a student wellness session at Shri Ram Academy",
    items: [
      "Child psychology & development",
      "Autism screening & assessment",
      "ADHD screening & assessment",
      "Behavioral issues & anger management",
      "Screen addiction (children & teens)",
      "Learning disability & psychometric testing",
    ],
  },
  {
    title: "Lifestyle, Career & Growth",
    href: "/services/corporate-workplace-wellness/",
    image: "/images/rehab-outreach/rehab-2.jpeg",
    imageAlt: "Iqra Ali delivering a workshop on cognitive strategies for change",
    items: [
      "Career guidance & counseling",
      "Workplace mental health & burnout support",
      "Financial stress counseling",
      "Self-esteem & confidence building",
      "Academic stress & exam anxiety",
      "Corporate Employee Assistance Programs (EAP)",
    ],
  },
];

const testimonials = [
  {
    quote:
      "From the very first session ma'am created a safe, welcoming space where I felt truly heard and understood.. Her ability to listen with empathy while offering thoughtful practical guidance has made a profound difference in my life.. What stands out most is her balance of professionalism and warmth.. Each session leaves me with a sense of clarity and hope.. If you're looking for someone who is compassionate, skilled and genuinely invested in your growth, Iqra ma'am is exceptional..!! 🫶🏻.",
    attribution: "Client H.",
  },
  {
    quote:
      "I'd say on s scale 1 – 10, I was on 0 when we began the session and I was having a nervous breakdown and panic attacks, the state that I was in, it could've been very hard for people to handle virtually but you dealt with it easily!\n\nWe started with identifying our triggers and then worked on emotional and physical regulation to gain clarity and figure out my real triggers whether it's really catastrophic or not.\n\nWe then did various grounding exercises and breath work.\n\nAlong side all of that and most importantly your great listening skills, empathetic approach and psycho-education helped me calm down a lot!\n\nForever grateful for all that!",
    attribution: "Client S. from UK",
  },
  {
    quote:
      "She has been really helpful in changing my thought process and listened to me efficiently..I'm so glad I got the right help..she totally changed my life..she's the best therapist I came across..I highly recommend her!",
    attribution: "Client N. from India",
  },
  {
    quote:
      "Iqra, when I felt I was caged inside myself! My thoughts were hurting me and I was so hopeless and helpless! I just looked up and prayed to god to send help! And then I found you. I went for it! I never considered therapy before, I was sceptical, scared and ashamed, kind of. But I convinced myself I need to do this. You helped me untangle my thoughts! You helped me with my anxiety. Following your technique worked for me indeed. But those worked temporarily! Till the time I listened to you! Till the time I talked to you!\n\nI believe therapy isn't just a course of medicine one take for a few days and everything is all right!\n\nMental health require consistent care, discipline to follow one's therapist advice and lots and lots of support.\n\nSo, Thank you for being there for me! Thank you for your amazing work! Thank you for your patience. Thank you for your support.",
    attribution: "Client M. from India",
  },
  {
    quote:
      "I took the therapy for my anxiety , mam spoke softly with me and i'm able to open up easily , the techniques she taught me was useful and worked well . The therapy was really useful to me .",
    attribution: "Client from India",
  },
];

const trustPoints = [
  "7+ years clinical, educational & corporate experience",
  "PhD Scholar, trained at Harvard Medical School",
  "In-person in Hyderabad + online worldwide",
  "Strictly confidential, judgment-free space",
];
---

<BaseLayout
  title="Liam Mind Care | Therapy & Counseling in Hyderabad"
  description="Confidential therapy for anxiety, depression, relationships, autism/ADHD & de-addiction. Hyderabad & online with psychologist Iqra Ali."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-100 via-sky-50 to-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-24 md:px-8">
      <div>
        <p class="inline-block rounded-full bg-blue-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-blue-600">
          Center for Mental Well-Being
        </p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-navy-900 md:text-5xl">
          A Calm, Confidential Space to Feel Better
        </h1>
        <p class="mt-3 font-serif text-xl italic text-blue-600">{site.tagline}.</p>
        <p class="mt-5 text-lg leading-relaxed text-navy-700">
          {site.supportingTagline}. Compassionate, evidence-based psychological therapy and counseling in
          Hyderabad and online worldwide — for anxiety, depression, relationships, autism & ADHD screening,
          teens, and life's toughest transitions.
        </p>
        <p class="mt-3 text-sm italic text-blue-600">You don't have to have it all figured out. You just have to start.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`https://wa.me/${site.whatsappRaw}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-navy-900 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
          >
            Book a Confidential Session
          </a>
          <a
            href={`tel:${site.phoneRaw}`}
            class="rounded-full border border-navy-800 px-7 py-3.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-blue-100"
          >
            Call {site.phoneDisplay}
          </a>
          <a
            href="/services/"
            class="rounded-full border border-navy-800 px-7 py-3.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-blue-100"
          >
            Explore Services
          </a>
        </div>
        <ul class="mt-8 grid grid-cols-1 gap-2 text-sm text-navy-700 sm:grid-cols-2">
          {trustPoints.map((point) => (
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 shrink-0 text-blue-500" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {point}
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-[2.5rem] shadow-xl">
          <img src="/images/space/space-8.jpeg" alt="Warm, welcoming waiting area at Liam Mind Care" class="h-full w-full object-cover" />
        </div>
        <div class="absolute -bottom-6 left-1/2 w-[85%] -translate-x-1/2 rounded-2xl bg-white p-5 text-center shadow-lg">
          <p class="text-sm font-medium text-navy-800">
            "A safe, welcoming space where I felt truly heard and understood."
          </p>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-blue-600">— Client H.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold text-navy-900">How We Can Support You</h2>
      <p class="mx-auto mt-3 max-w-2xl text-navy-700">
        Whatever brought you here, there is a path forward. Explore the areas we support most often.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar) => (
        <a href={pillar.href} class="group flex flex-col overflow-hidden rounded-3xl border border-blue-100 bg-white transition-shadow hover:shadow-lg">
          <div class="aspect-[16/10] w-full overflow-hidden">
            <img src={pillar.image} alt={pillar.imageAlt} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="flex flex-1 flex-col p-7">
            <h3 class="font-serif text-xl font-semibold text-navy-900">{pillar.title}</h3>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-navy-700">
              {pillar.items.map((item) => <li>• {item}</li>)}
            </ul>
            <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-600">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:grid-cols-2 md:px-8">
      <div class="order-2 md:order-1">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-3xl shadow-md">
          <img src="/images/rehab-outreach/rehab-5.jpeg" alt="Iqra Ali, PhD Scholar and founder of Liam Mind Care, delivering a community workshop" class="h-full w-full object-cover object-top" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Meet Your Psychologist</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-navy-900">Iqra Ali</h2>
        <p class="mt-1 text-sm font-medium text-blue-600">PhD Scholar — Clinical Psychology</p>
        <p class="mt-4 leading-relaxed text-navy-700">
          With 7+ years of experience across clinical, educational, and corporate settings, Iqra brings an
          integrative, trauma-informed approach drawing from CBT, DBT, psychodynamic, and solution-focused
          therapy — including advanced training in General Psychiatric Management for Borderline Personality
          Disorder from Harvard Medical School.
        </p>
        <p class="mt-4 italic text-navy-700">
          "Seeking support is not a weakness — it is a courageous step toward healing, resilience, and
          transformation."
        </p>
        <a href="/about/" class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700">
          Read Iqra's full story
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold text-navy-900">What Clients Say</h2>
      <p class="mx-auto mt-3 max-w-2xl text-navy-700">Real words from people who found their way to a calmer place.</p>
    </div>
    <div class="mt-10 grid items-start gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="flex flex-col rounded-3xl border border-blue-100 bg-white p-7">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" class="shrink-0 text-blue-300"><path d="M9.5 7C6.5 7 4 9.5 4 12.5c0 2.5 1.7 4.5 4 4.9-.3 1.4-1.3 2.4-2.6 2.9v1.7c3-.4 5.6-2.9 5.6-6.5V7H9.5Zm9 0c-3 0-5.5 2.5-5.5 5.5 0 2.5 1.7 4.5 4 4.9-.3 1.4-1.3 2.4-2.6 2.9v1.7c3-.4 5.6-2.9 5.6-6.5V7h-1.5Z" fill="currentColor"/></svg>
          <div class="mt-4 flex-1 space-y-3 text-navy-700">
            {t.quote.split("\n\n").map((para, i, arr) => (
              <p>{i === 0 ? `"${para}` : para}{i === arr.length - 1 ? `"` : ""}</p>
            ))}
          </div>
          <p class="mt-5 text-sm font-semibold uppercase tracking-wide text-blue-600">— {t.attribution}</p>
        </div>
      ))}
    </div>
  </section>

  <GoogleReviews reviews={googleReviews} />

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:grid-cols-2 md:px-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">For Schools, Colleges & Organizations</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-navy-900">Bring a Workshop to Your Organization</h2>
        <p class="mt-4 leading-relaxed text-navy-700">
          Iqra Ali regularly delivers mental health awareness workshops and community programs — from student
          wellness seminars to de-addiction and rehabilitation awareness sessions — featured in local press and
          TV coverage across Hyderabad and beyond.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`mailto:${site.email}?subject=${encodeURIComponent("Workshop Enquiry")}&body=${encodeURIComponent("Hi, I'd like to enquire about booking a mental health workshop for my organization/school.")}`}
            class="rounded-full bg-navy-900 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
          >
            Book a Workshop
          </a>
          <a
            href="/workshops/"
            class="rounded-full border border-navy-800 px-7 py-3.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-blue-100"
          >
            See Our Workshops
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="aspect-square overflow-hidden rounded-2xl shadow-md">
          <img src="/images/rehab-outreach/rehab-4.jpeg" alt="Community awareness workshop session" class="h-full w-full object-cover" />
        </div>
        <div class="mt-8 aspect-square overflow-hidden rounded-2xl shadow-md">
          <img src="/images/student-engagement/shri-ram-academy.jpeg" alt="School mental health session at Shri Ram Academy" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 md:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold text-navy-900">Common Questions</h2>
    <div class="mt-8 space-y-3">
      <FAQItem question="How do I book a session?" open>
        Simply reach out via WhatsApp or the contact form. We'll confirm a time that works for you — sessions
        are by appointment only, available online worldwide or in-person across Hyderabad (Narsingi, Manikonda,
        Kokapet, and Tolichowki).
      </FAQItem>
      <FAQItem question="Is everything I share confidential?">
        Yes. All sessions are strictly confidential and handled with complete discretion, in line with
        professional ethical standards.
      </FAQItem>
      <FAQItem question="Do I need a diagnosis or referral to start?">
        No referral or prior diagnosis is needed. Many clients simply want a safe space to talk through stress,
        relationships, or life transitions — you don't need a "reason" to begin therapy.
      </FAQItem>
    </div>
    <div class="mt-8 text-center">
      <a href="/faq/" class="text-sm font-semibold text-blue-600 hover:text-blue-700">View all FAQs →</a>
    </div>
  </section>

  <WaveDivider toColor="#16265c" />
  <CTASection />
</BaseLayout>
