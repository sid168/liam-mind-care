---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";

const concerns = [
  "Anxiety & panic attacks",
  "Depression & low mood",
  "Stress & burnout",
  "OCD & intrusive thoughts",
  "Trauma & abuse recovery",
  "Phobias & fears",
  "Anger management",
  "Smoking, alcohol & substance de-addiction",
  "Rehab & post-rehab support",
  "Substance use case management",
  "Relapse prevention",
  "Sleep problems & insomnia",
  "Postpartum & women's mental health",
  "Life transitions",
];
---

<ServiceLayout
  seoTitle="Individual Therapy in Hyderabad | Liam Mind Care"
  seoDescription="One-on-one therapy for anxiety, depression, trauma, anger & de-addiction. Confidential care with Iqra Ali, Hyderabad & online."
  eyebrow="Individual Therapy"
  heading="Individual Therapy for Emotional Wellbeing"
  intro="One-on-one individual therapy — a safe, supportive, and strictly confidential space to work through anxiety, depression, stress, and life's transitions — at your own pace, in-person in Hyderabad or online worldwide."
  heroImage="/images/media-coverage/iqra-consultation.jpeg"
  heroImageAlt="Iqra Ali in a real individual counseling session"
  concerns={concerns}
  format={[
    { label: "Session length", value: "60 minutes" },
    { label: "Delivery", value: "Online worldwide or in-person in Hyderabad" },
    { label: "Languages", value: "English, Hindi/Urdu" },
    { label: "Booking", value: "By appointment only" },
  ]}
  relatedServices={[
    { href: "/services/couples-family-counseling/", label: "Couples & Family Counseling" },
    { href: "/services/psychological-assessments/", label: "Child Psychology & Assessments" },
    { href: "/workshops/", label: "Workshops & Community Programs" },
  ]}
>
  <h2 class="font-serif text-2xl font-semibold text-navy-900">Our Approach</h2>
  <p class="mt-4 leading-relaxed text-navy-700">
    Individual therapy sessions draw on Cognitive Behavioral Therapy (CBT), DBT-informed techniques,
    psychodynamic therapy, and solution-focused approaches — tailored to what you need, not a one-size-fits-all
    script. Every session is delivered with warmth, respect, and complete discretion.
  </p>
  <p class="mt-4 leading-relaxed text-navy-700">
    Whether you're managing a diagnosed condition or simply need a space to think out loud, no referral or
    prior diagnosis is required to begin.
  </p>
  <div class="mt-6 overflow-hidden rounded-2xl">
    <img src="/images/space/space-5.jpeg" alt="Calming hallway at Liam Mind Care with an encouraging quote" class="h-64 w-full object-cover" loading="lazy" />
  </div>
  <h2 class="mt-8 font-serif text-2xl font-semibold text-navy-900">De-Addiction & Relapse Prevention</h2>
  <p class="mt-4 leading-relaxed text-navy-700">
    Individual counseling also includes focused support for smoking, alcohol, and substance use de-addiction —
    working through triggers, building coping strategies, and staying supported through relapse prevention, at
    a pace that respects where you're starting from.
  </p>
  <p class="mt-4 leading-relaxed text-navy-700">
    We also work directly with rehab and post-rehab patients, supporting substance use cases with structured
    de-addiction techniques and ongoing relapse prevention — helping clients and their families navigate
    recovery as a continuing process, not a single fix.
  </p>
</ServiceLayout>
