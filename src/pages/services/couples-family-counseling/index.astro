---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";

const concerns = [
  "Marital conflict & communication breakdown",
  "Rebuilding trust after betrayal",
  "Pre-marital counseling",
  "Family & parenting conflict",
  "Narcissistic abuse recovery",
  "Women's mental health & postpartum support",
  "Emotional & behavioral concerns in the family",
  "Life transitions as a couple or family",
];
---

<ServiceLayout
  seoTitle="Couples & Family Counseling in Hyderabad"
  seoDescription="Couples counseling and family therapy in Hyderabad and online. Rebuild trust and improve communication, confidentially."
  eyebrow="Couples Therapy & Family Therapy"
  heading="Couples Therapy & Family Therapy"
  intro="Sessions focused on rebuilding trust, improving communication, and resolving conflict — couples therapy for partners, and family therapy for parents and families navigating a difficult season together. In-person in Hyderabad or online worldwide."
  heroImage="/images/space/space-1.jpeg"
  heroImageAlt="Comfortable counseling room at Liam Mind Care"
  concerns={concerns}
  format={[
    { label: "Session length", value: "Up to 90 minutes" },
    { label: "Delivery", value: "Online worldwide or in-person in Hyderabad" },
    { label: "Languages", value: "English, Hindi/Urdu" },
    { label: "Booking", value: "By appointment only" },
  ]}
  relatedServices={[
    { href: "/services/individual-therapy/", label: "Individual Therapy" },
    { href: "/services/teen-adolescent-counseling/", label: "Teen & Adolescent Counseling" },
  ]}
>
  <h2 class="font-serif text-2xl font-semibold text-navy-900">Our Approach</h2>
  <p class="mt-4 leading-relaxed text-navy-700">
    Couples and family sessions run up to 90 minutes to allow enough space for both partners — or the whole
    family — to be heard. We work on practical communication tools alongside deeper, trauma-informed work when
    needed, including support for recovering from narcissistic abuse or emotionally difficult family dynamics.
  </p>
  <p class="mt-4 leading-relaxed text-navy-700">
    All sessions are strictly confidential and handled with complete discretion, whether you attend together or
    begin with an individual consultation first.
  </p>
</ServiceLayout>
