---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";

const concerns = [
  "Career guidance & counseling",
  "Workplace mental health & burnout",
  "Mental health in high-risk industries (Oil & Gas, industrial safety)",
  "Financial stress counseling",
  "Body image & weight management counseling",
  "Self-esteem & confidence building",
  "Academic stress & exam anxiety",
  "Corporate Employee Assistance Programs (EAP)",
  "School mental health & wellness programs",
];
---

<ServiceLayout
  seoTitle="Corporate Wellness & EAP Services Hyderabad"
  seoDescription="Workplace mental health, EAP programs & career counseling in Hyderabad and online, led by an HR & industrial psychologist."
  eyebrow="Lifestyle, Career & Growth"
  heading="Corporate & Workplace Wellness"
  intro="Practical, psychologically-informed support for burnout, career transitions, and workplace mental health — drawing on real HR and industrial psychology experience, not just theory."
  heroImage="/images/rehab-outreach/rehab-1.jpeg"
  heroImageAlt="Iqra Ali delivering a community awareness workshop"
  concerns={concerns}
  format={[
    { label: "Formats", value: "1:1 sessions, corporate EAP programs, school workshops" },
    { label: "Delivery", value: "Online worldwide or in-person in Hyderabad" },
    { label: "Languages", value: "English, Hindi/Urdu" },
    { label: "Booking", value: "By appointment; organizations can request a proposal" },
  ]}
  relatedServices={[
    { href: "/workshops/", label: "Workshops & Community Programs" },
    { href: "/services/individual-therapy/", label: "Individual Therapy" },
  ]}
>
  <h2 class="font-serif text-2xl font-semibold text-navy-900">Our Approach</h2>
  <p class="mt-4 leading-relaxed text-navy-700">
    Drawing on 7+ years as an HR and Industrial Psychologist, Iqra brings a practical understanding of
    workplace pressure to every session — from individual burnout and career-crossroads counseling to
    organization-wide Employee Assistance Programs and school mental health & wellness initiatives.
  </p>
  <p class="mt-4 leading-relaxed text-navy-700">
    This includes work in high-risk industrial settings — including a session on <em>Managing Mental Health in
    High-Risk Sites</em> for oil & gas industry teams, covering psychosocial risk and safe operations with FAST
    Solutions 4 Safety.
  </p>
  <p class="mt-4 leading-relaxed text-navy-700">
    If you're an organization or school interested in a wellness program, reach out to discuss a tailored
    proposal — or see our <a href="/workshops/" class="font-semibold text-blue-600 hover:text-blue-700">Workshops & Community Programs</a> page for topics, press coverage, and past organizations we've worked with.
  </p>
  <div class="mt-6 overflow-hidden rounded-2xl">
    <img src="/images/rehab-outreach/high-risk-industry-3.jpeg" alt="Iqra Ali delivering a Managing Mental Health in High-Risk Sites session for oil & gas industry teams" class="h-64 w-full object-cover" loading="lazy" />
  </div>
</ServiceLayout>
