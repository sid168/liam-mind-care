---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { site } from "../../data/site";

const mapQuery = encodeURIComponent(site.address.full);
---

<BaseLayout
  title="Contact Us | Liam Mind Care Hyderabad"
  description="Book a confidential therapy session at Liam Mind Care. Call, WhatsApp, or send a message — in-person in Hyderabad or online worldwide."
>
  <Breadcrumbs items={[{ name: "Contact", href: "/contact/" }]} />
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="text-center">
      <h1 class="font-serif text-4xl font-semibold text-navy-900">Get in Touch</h1>
      <p class="mx-auto mt-3 max-w-xl text-navy-700">
        Reach out for a confidential conversation about booking a session. We reply as quickly as we can —
        sessions are by appointment only.
      </p>
    </div>

    <div class="mt-10 aspect-[21/8] w-full overflow-hidden rounded-3xl shadow-md">
      <img src="/images/space/space-6.jpeg" alt="Welcoming office space at Liam Mind Care, Hyderabad" class="h-full w-full object-cover" />
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div class="space-y-6">
        <div class="rounded-2xl border border-blue-100 p-6">
          <h2 class="font-serif text-lg font-semibold text-navy-900">Send a Message</h2>
          <form
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
            class="mt-4 space-y-4"
          >
            <div>
              <label for="name" class="block text-sm font-medium text-navy-800">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-lg border border-blue-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-navy-800">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 w-full rounded-lg border border-blue-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-navy-800">Phone (optional)</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="mt-1 w-full rounded-lg border border-blue-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-navy-800">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="mt-1 w-full rounded-lg border border-blue-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:outline-none"
              ></textarea>
            </div>
            <p class="text-xs text-navy-700">
              This form is for general inquiries only. If you are in crisis, please contact local emergency
              services immediately rather than using this form.
            </p>
            <button
              type="submit"
              class="w-full rounded-full bg-navy-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
            >
              Send Message
            </button>
          </form>
        </div>

        <div class="rounded-2xl bg-blue-100/60 p-6 text-center">
          <p class="text-sm text-navy-800">Prefer to talk directly?</p>
          <a
            href={`https://wa.me/${site.whatsappRaw}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white"
          >
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl border border-blue-100 p-6">
          <h2 class="font-serif text-lg font-semibold text-navy-900">Contact Details</h2>
          <ul class="mt-4 space-y-4 text-sm text-navy-700">
            <li>
              <span class="block font-semibold text-navy-800">Phone / WhatsApp</span>
              <a href={`tel:${site.phoneRaw}`} class="text-blue-600 hover:text-blue-700">{site.phoneDisplay}</a>
              <span class="text-navy-500"> ({site.hours})</span>
            </li>
            <li>
              <span class="block font-semibold text-navy-800">Email</span>
              <a href={`mailto:${site.email}`} class="text-blue-600 hover:text-blue-700">{site.email}</a>
            </li>
            <li>
              <span class="block font-semibold text-navy-800">Address</span>
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.line3}
            </li>
            <li>
              <span class="block font-semibold text-navy-800">Areas Served</span>
              {site.serviceAreas.join(", ")}, and online worldwide
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-2xl border border-blue-100">
          <iframe
            title="Liam Mind Care location map"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            width="100%"
            height="280"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
