---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import InstagramEmbed from "../../components/InstagramEmbed.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { site } from "../../data/site";

const instagramPosts = [
  "https://www.instagram.com/reel/DZw2Z1OzE05/",
  "https://www.instagram.com/p/DYzSzooTUf5/",
  "https://www.instagram.com/reel/DXbLYIGk1Dw/",
];

const space = Array.from({ length: 8 }, (_, i) => `/images/space/space-${i + 1}.jpeg`);
const certificates = Array.from({ length: 11 }, (_, i) => `/images/certificates/cert-${i + 1}.jpeg`);
const media = [
  "/images/media-coverage/media-1.jpeg",
  "/images/media-coverage/media-2.jpeg",
  "/images/media-coverage/media-3.jpeg",
  "/images/media-coverage/media-7-aadab-telangana.jpeg",
  "/images/media-coverage/media-8-etemaad-daily.jpeg",
  "/images/media-coverage/media-4-akstv-1.jpeg",
  "/images/media-coverage/media-5-akstv-2.jpeg",
  "/images/media-coverage/media-6-99tv.jpeg",
];
const rehabOutreach = [
  "/images/rehab-outreach/rehab-2.jpeg",
  "/images/rehab-outreach/rehab-5.jpeg",
  "/images/rehab-outreach/rehab-1.jpeg",
  "/images/rehab-outreach/rehab-4.jpeg",
  "/images/rehab-outreach/rehab-3.jpeg",
];
const community = [
  { src: "/images/student-engagement/shri-ram-academy.jpeg", caption: "Peace & Conflict Resolution session at Shri Ram Academy, Hyderabad" },
  { src: "/images/student-engagement/gsss-cheema-jodhpur.jpeg", caption: "Mental health awareness session at PM Shree GSSS Cheema Jodhpur School" },
];
const events = [
  "/images/events/odyssey-solo.jpeg",
  "/images/events/odyssey-group-1.jpeg",
  "/images/events/odyssey-group-2.jpeg",
];
---

<BaseLayout
  title="Gallery | Liam Mind Care"
  description="A look inside Liam Mind Care — our space, certifications, media coverage, and community mental health work."
>
  <Breadcrumbs items={[{ name: "Gallery", href: "/gallery/" }]} />
  <section class="mx-auto max-w-5xl px-5 py-16 text-center md:px-8">
    <h1 class="font-serif text-4xl font-semibold text-navy-900">Gallery</h1>
    <p class="mx-auto mt-4 max-w-2xl text-navy-700">
      A look inside our space, our training, and the work we're proud of.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:px-8">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-2xl font-semibold text-navy-900">Recent Work on Instagram</h2>
      <a href="https://www.instagram.com/liammindcare/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-blue-600 hover:text-blue-700">
        Follow @liammindcare →
      </a>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {instagramPosts.map((url) => <InstagramEmbed url={url} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:px-8">
    <h2 class="font-serif text-2xl font-semibold text-navy-900">Our Space</h2>
    <p class="mt-2 text-navy-700">A calm, welcoming environment designed to put you at ease.</p>
    <div class="mt-6 columns-2 gap-4 sm:columns-3 md:columns-4 [&>*]:mb-4">
      {space.map((src) => (
        <img src={src} alt="Liam Mind Care therapy space" class="w-full rounded-2xl object-cover shadow-sm" loading="lazy" />
      ))}
    </div>
  </section>

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <h2 class="font-serif text-2xl font-semibold text-navy-900">Certifications & Training</h2>
      <p class="mt-2 text-navy-700">Iqra Ali's ongoing professional development and training credentials.</p>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
        {certificates.map((src) => (
          <div class="overflow-hidden rounded-xl border border-blue-200 bg-white shadow-sm">
            <img src={src} alt="Certification" class="h-44 w-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <h2 class="font-serif text-2xl font-semibold text-navy-900">Media Coverage</h2>
    <p class="mt-2 text-navy-700">Press and TV features on Liam Mind Care's work.</p>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {media.map((src) => (
        <div class="overflow-hidden rounded-xl border border-blue-200 bg-white shadow-sm">
          <img src={src} alt="Media coverage of Liam Mind Care" class="h-48 w-full object-cover sm:h-56" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <h2 class="font-serif text-2xl font-semibold text-navy-900">Rehabilitation & De-Addiction Outreach</h2>
      <p class="mt-2 text-navy-700">
        Community Awareness Programs on addiction, de-addiction, and rehabilitation for alcohol, tobacco, and
        substance use — with the Department of Rehabilitation Psychology, Padamanayaka College of Special
        Education.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {rehabOutreach.map((src) => (
          <div class="overflow-hidden rounded-xl border border-blue-200 bg-white shadow-sm">
            <img src={src} alt="Rehabilitation and de-addiction community awareness program" class="h-44 w-full object-cover sm:h-56" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <h2 class="font-serif text-2xl font-semibold text-navy-900">Community & School Engagement</h2>
    <p class="mt-2 text-navy-700">Bringing mental health awareness into schools and communities.</p>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {community.map((item) => (
        <figure class="overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-sm">
          <img src={item.src} alt={item.caption} class="h-56 w-full object-cover" loading="lazy" />
          <figcaption class="p-4 text-sm text-navy-700">{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="bg-blue-100/50 py-16">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <h2 class="font-serif text-2xl font-semibold text-navy-900">Conferences & Events</h2>
      <p class="mt-2 text-navy-700">
        Odyssey 3.0 — Autism and Humanity: Every Life Has Value, a conference by Rainbow Children's Hospital's
        Child Development Center (11–12 July 2026, Hyderabad).
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {events.map((src) => (
          <div class="overflow-hidden rounded-xl border border-blue-200 bg-white shadow-sm">
            <img src={src} alt="Iqra Ali at the Odyssey 3.0 autism conference" class="h-56 w-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />

  <script is:inline async src="https://www.instagram.com/embed.js"></script>
</BaseLayout>
