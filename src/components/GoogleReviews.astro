---
import { site } from "../data/site";

interface Review {
  name: string;
  time: string;
  text: string;
  truncated?: boolean;
}

interface Props {
  reviews: Review[];
  heading?: string;
}

const { reviews, heading = "Google Reviews" } = Astro.props;

const googleReviewUrl = "https://share.google/B6FWNk8AUV3TZlIs9";
---

<section class="mx-auto max-w-6xl px-5 py-16 md:px-8">
  <div class="text-center">
    <div class="inline-flex items-center gap-2">
      <svg width="24" height="24" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.43.34-2.09V7.07H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.93l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/></svg>
      <h2 class="font-serif text-3xl font-semibold text-navy-900">{heading}</h2>
    </div>
    <div class="mt-2 flex items-center justify-center gap-1.5 text-sm text-navy-700">
      <span class="flex text-amber-400">
        {Array.from({ length: 5 }).map(() => (
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6L10 1.5z"/></svg>
        ))}
      </span>
      <span class="font-semibold">5.0</span>
      <span>· real reviews from Google</span>
    </div>
  </div>
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {reviews.map((r) => (
      <div class="flex flex-col rounded-2xl border border-blue-100 bg-white p-6">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100 font-serif font-semibold text-navy-800">
            {r.name.charAt(0)}
          </div>
          <div>
            <p class="text-sm font-semibold text-navy-900">{r.name}</p>
            <p class="text-xs text-navy-500">Google · {r.time}</p>
          </div>
        </div>
        <div class="mt-2 flex text-amber-400">
          {Array.from({ length: 5 }).map(() => (
            <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6L10 1.5z"/></svg>
          ))}
        </div>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-700">
          {r.text}{r.truncated && "…"}
        </p>
        {r.truncated && (
          <a href={googleReviewUrl} target="_blank" rel="noopener noreferrer" class="mt-2 text-xs font-semibold text-blue-600 hover:text-blue-700">
            Read full review on Google →
          </a>
        )}
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a
      href={googleReviewUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700"
    >
      See all reviews on Google →
    </a>
  </div>
</section>
