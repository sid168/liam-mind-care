---
import { site } from "../data/site";

const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-blue-100">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 md:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <svg width="36" height="36" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="20" cy="20" r="19" stroke="#12296b" stroke-width="1.5" fill="#e7f1fb"/>
        <path d="M20 10c-4 0-7 3-7 7 0 3 2 5 3 6.5V27a1 1 0 001 1h6a1 1 0 001-1v-3.5c1-1.5 3-3.5 3-6.5 0-4-3-7-7-7z" stroke="#12296b" stroke-width="1.5" fill="none"/>
        <path d="M20 14v4M17.5 16h5" stroke="#2f6fc4" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="font-serif leading-none">
        <span class="block text-lg font-semibold tracking-tight text-navy-900">LIAM Mind Care</span>
        <span class="block text-[10px] uppercase tracking-[0.18em] text-blue-500">Center for Mental Well-Being</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-sm font-medium transition-colors hover:text-blue-600",
            currentPath === item.href ? "text-blue-600" : "text-navy-800",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href={`https://wa.me/${site.whatsappRaw}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-navy-800 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
      >
        Book a Session
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="h-0.5 w-6 bg-navy-900"></span>
      <span class="h-0.5 w-6 bg-navy-900"></span>
      <span class="h-0.5 w-6 bg-navy-900"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-blue-100 bg-white px-5 py-3 md:hidden">
    {nav.map((item) => (
      <a
        href={item.href}
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-navy-800 hover:bg-blue-100"
      >
        {item.label}
      </a>
    ))}
    <a
      href={`https://wa.me/${site.whatsappRaw}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 rounded-full bg-navy-800 px-4 py-2.5 text-center text-sm font-semibold text-white"
    >
      Book a Session
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });
</script>
