---
import { site } from "../data/site";

const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-blue-100">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 md:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/images/logo-icon.png" width="40" height="40" alt="Liam Mind Care logo" class="h-10 w-10" />
      <span class="font-serif leading-none">
        <span class="block text-lg font-semibold tracking-tight text-navy-900">LIAM Mind Care</span>
        <span class="block text-[10px] uppercase tracking-[0.18em] text-blue-500">Center for Mental Well-Being</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-sm font-medium transition-colors hover:text-blue-600",
            currentPath === item.href ? "text-blue-600" : "text-navy-800",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href={`https://wa.me/${site.whatsappRaw}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-navy-800 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-600"
      >
        Book a Session
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="h-0.5 w-6 bg-navy-900"></span>
      <span class="h-0.5 w-6 bg-navy-900"></span>
      <span class="h-0.5 w-6 bg-navy-900"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-blue-100 bg-cream px-5 py-3 md:hidden">
    {nav.map((item) => (
      <a
        href={item.href}
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-navy-800 hover:bg-blue-100"
      >
        {item.label}
      </a>
    ))}
    <a
      href={`https://wa.me/${site.whatsappRaw}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 rounded-full bg-navy-800 px-4 py-2.5 text-center text-sm font-semibold text-white"
    >
      Book a Session
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });
</script>
