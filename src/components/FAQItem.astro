---
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---

<details class="group rounded-xl border border-blue-100 bg-white px-5 py-1 open:shadow-sm" open={open}>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium text-navy-900">
    {question}
    <span class="shrink-0 text-blue-500 transition-transform group-open:rotate-45">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </span>
  </summary>
  <div class="pb-4 text-sm leading-relaxed text-navy-700">
    <slot />
  </div>
</details>
