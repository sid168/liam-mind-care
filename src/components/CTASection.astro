---
import { site } from "../data/site";

interface Props {
  heading?: string;
  subheading?: string;
  whatsappLabel?: string;
  whatsappMessage?: string;
  primaryHref?: string;
  primaryLabel?: string;
}

const {
  heading = "Taking the first step takes courage. We're here to make it easier.",
  subheading = "Reach out for a confidential conversation about how therapy can help — no pressure, no judgment.",
  whatsappLabel = "Book a Session on WhatsApp",
  whatsappMessage,
  primaryHref,
  primaryLabel,
} = Astro.props;

const whatsappUrl = whatsappMessage
  ? `https://wa.me/${site.whatsappRaw}?text=${encodeURIComponent(whatsappMessage)}`
  : `https://wa.me/${site.whatsappRaw}`;

const buttonHref = primaryHref ?? whatsappUrl;
const buttonLabel = primaryLabel ?? whatsappLabel;
const isExternalTab = !primaryHref || primaryHref.startsWith("http");
---

<section class="bg-navy-900 py-16">
  <div class="mx-auto max-w-3xl px-5 text-center">
    <h2 class="font-serif text-2xl font-semibold text-white md:text-3xl">{heading}</h2>
    <p class="mt-3 text-blue-200">{subheading}</p>
    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={buttonHref}
        target={isExternalTab ? "_blank" : undefined}
        rel={isExternalTab ? "noopener noreferrer" : undefined}
        class="rounded-full bg-white px-7 py-3 text-sm font-semibold text-navy-900 transition-colors hover:bg-blue-100"
      >
        {buttonLabel}
      </a>
      <a
        href={`tel:${site.phoneRaw}`}
        class="rounded-full border border-blue-400 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
      >
        Call {site.phoneDisplay}
      </a>
      <a
        href="/contact/"
        class="rounded-full border border-blue-400 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
      >
        Contact Us
      </a>
    </div>
  </div>
</section>
