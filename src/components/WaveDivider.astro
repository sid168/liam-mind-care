---
interface Props {
  flip?: boolean;
  fromColor?: string;
  toColor?: string;
}
const { flip = false, fromColor = "#eaf3fc", toColor = "#16265c" } = Astro.props;
---

<div class:list={["w-full leading-none", flip && "rotate-180"]} aria-hidden="true">
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none" class="h-16 w-full md:h-24">
    <path
      d="M0,40 C280,100 480,0 760,30 C1040,60 1200,10 1440,40 L1440,100 L0,100 Z"
      fill={toColor}
    />
    <path
      d="M0,55 C280,110 480,20 760,50 C1040,80 1200,30 1440,55 L1440,100 L0,100 Z"
      fill={toColor}
      opacity="0.6"
    />
  </svg>
</div>
