---
import BaseLayout from "./BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import JsonLd from "../components/JsonLd.astro";
import { site } from "../data/site";

interface Props {
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  heading: string;
  intro: string;
  heroImage: string;
  heroImageAlt: string;
  concernsTitle?: string;
  concerns: string[];
  format: { label: string; value: string }[];
}

const {
  seoTitle,
  seoDescription,
  eyebrow,
  heading,
  intro,
  heroImage,
  heroImageAlt,
  concernsTitle = "What We Help With",
  concerns,
  format,
} = Astro.props;

const pagePath = Astro.url.pathname;
const pageUrl = new URL(pagePath, site.url).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalTherapy",
  name: heading,
  description: intro,
  url: pageUrl,
  provider: {
    "@type": "MedicalBusiness",
    name: site.name,
    url: site.url,
    telephone: site.phoneRaw,
  },
  areaServed: site.serviceAreas,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Services", item: new URL("/services/", site.url).toString() },
    { "@type": "ListItem", position: 3, name: heading, item: pageUrl },
  ],
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <JsonLd data={serviceSchema} />
  <JsonLd data={breadcrumbSchema} />
  <section class="bg-blue-100/60 py-14">
    <div class="mx-auto max-w-5xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-navy-700">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-1.5">/</span>
        <a href="/services/" class="hover:text-blue-600">Services</a>
        <span class="mx-1.5">/</span>
        <span class="text-navy-900">{heading}</span>
      </nav>
    </div>
    <div class="mx-auto grid max-w-5xl items-center gap-8 px-5 md:grid-cols-[1.1fr_1fr] md:px-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">{eyebrow}</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold text-navy-900">{heading}</h1>
        <p class="mt-4 text-navy-700">{intro}</p>
      </div>
      <div class="aspect-[4/3] w-full overflow-hidden rounded-3xl shadow-md">
        <img src={heroImage} alt={heroImageAlt} class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-5xl gap-10 px-5 py-14 md:grid-cols-[1fr_260px] md:px-8">
    <div>
      <h2 class="font-serif text-2xl font-semibold text-navy-900">{concernsTitle}</h2>
      <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {concerns.map((c) => (
          <li class="flex items-start gap-2 rounded-lg border border-blue-100 px-4 py-3 text-sm text-navy-700">
            <span class="mt-0.5 shrink-0 text-blue-500">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {c}
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <slot />
      </div>
    </div>

    <aside class="h-fit rounded-2xl border border-blue-100 p-6">
      <h3 class="font-serif text-lg font-semibold text-navy-900">Session Format</h3>
      <dl class="mt-4 space-y-3 text-sm">
        {format.map((f) => (
          <div>
            <dt class="font-semibold text-navy-800">{f.label}</dt>
            <dd class="text-navy-700">{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-5 border-t border-blue-100 pt-4">
        <p class="text-sm font-semibold text-navy-800">Fees</p>
        <p class="mt-1 text-sm text-navy-700">
          Reach out on <a href={`https://wa.me/${site.whatsappRaw}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-600 hover:text-blue-700">WhatsApp</a> for current session rates.
        </p>
      </div>
    </aside>
  </section>

  <CTASection />
</BaseLayout>
